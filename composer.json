{
    "name": "calevans/staticforge-popup",
    "description": "Popup feature for StaticForge",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Cal Evans",
            "email": "cal@calevans.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "eicc/staticforge": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Calevans\\StaticForgePopup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Calevans\\StaticForgePopup\\Tests\\": "tests/"
        }
    },
    "extra": {
        "staticforge": {
            "feature": "Calevans\\StaticForgePopup\\Feature"
        }
    }
}
